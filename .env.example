# Optional override of the Firebase Web app configuration in src/firebase.js.
# Copy to .env.local only if using another Firebase project. Set every required
# value; storage bucket, messaging sender ID and measurement ID are optional. Never put a
# service-account private key in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
