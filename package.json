{
  "name": "foodbridge-pk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "grant-admin": "node scripts/grant-admin.js",
    "lint:rules": "eslint firestore.rules",
    "test:rules": "node scripts/require-emulators.js && vitest run --no-file-parallelism tests/rules.emulator.test.js",
    "build:admin": "vite build --config vite.admin.config.js && node scripts/admin-index.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "firebase": "^11.10.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@firebase/rules-unit-testing": "^4.0.1",
    "eslint": "^10.14.0",
    "firebase-admin": "14.5.0",
    "jsdom": "^26.1.0",
    "vite": "6.4.5",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": "^22.13.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.7"
  }
}
